--// Blackhole Effect
local activeEffect = nil
local connections = {}
local activeClones = {}

local effectSize = 1
local particleBoost = 2

local effectAssets = {
    Real = "rbxassetid://127391960000433",
    Purple = "rbxassetid://76490441012398",
    Water = "rbxassetid://9528329581",
}

local loadedAssets = {}

local function getAsset(name)
    if loadedAssets[name] then
        return loadedAssets[name]
    end

    local ok, result = pcall(function()
        return game:GetObjects(effectAssets[name])[1]
    end)

    if not ok or not result then
        return nil
    end

    for _, v in ipairs(result:GetDescendants()) do
        if v:IsA("ParticleEmitter") then
            v.Enabled = false
        end
    end

    loadedAssets[name] = result

    return result
end

local function scaleParticles(clone, scale)
    local finalScale = scale * particleBoost

    for _, v in ipairs(clone:GetDescendants()) do
        if v:IsA("ParticleEmitter") then
            if not v:GetAttribute("OriginalSize") then
                v:SetAttribute(
                    "OriginalSize",
                    v.Size
                )
            end

            local original =
                v:GetAttribute("OriginalSize")

            if original then
                local newKeypoints = {}

                for _, kp in ipairs(original.Keypoints) do
                    table.insert(
                        newKeypoints,
                        NumberSequenceKeypoint.new(
                            kp.Time,
                            kp.Value * finalScale,
                            kp.Envelope * finalScale
                        )
                    )
                end

                v.Size =
                    NumberSequence.new(newKeypoints)
            end
        end
    end
end

local function getPrimaryPart(obj)
    if obj:IsA("BasePart") then
        return obj
    end

    if obj:IsA("Model") then
        return obj.PrimaryPart
            or obj:FindFirstChildWhichIsA(
                "BasePart",
                true
            )
    end

    return nil
end

local function getScale(clone, hole)
    local primary = getPrimaryPart(clone)

    if not primary then
        return 1
    end

    return hole.Size.Magnitude
        * effectSize
        / math.max(primary.Size.Magnitude, 0.01)
end

local function setCloneSizeAndPosition(clone, hole)
    if not clone or not clone.Parent then
        return
    end

    if not hole or not hole.Parent then
        return
    end

    local primary = getPrimaryPart(clone)

    if not primary then
        return
    end

    local scale = getScale(clone, hole)

    if clone:IsA("Model") then
        clone:ScaleTo(scale)
        clone:PivotTo(CFrame.new(hole.Position))
    elseif clone:IsA("BasePart") then
        clone.Size = hole.Size * effectSize
        clone.Position = hole.Position
    end

    scaleParticles(clone, scale)
end

local function applyEffect(v)
    if not activeEffect then
        return
    end

    if activeClones[v] then
        return
    end

    local hole = v:FindFirstChild("Hole")

    if not hole or not hole:IsA("BasePart") then
        return
    end

    hole.CanCollide = false
    hole.CanTouch = false
    hole.CanQuery = false
    hole.Transparency = 1

    local template = getAsset(activeEffect)

    if not template then
        return
    end

    local clone = template:Clone()
    clone.Parent = v

    for _, p in ipairs(clone:GetDescendants()) do
        if p:IsA("ParticleEmitter") then
            CollectionService:AddTag(p, "Particle")
            p.Enabled = true
        end
    end

    activeClones[v] = clone

    task.spawn(function()
        while v.Parent
            and clone.Parent
            and activeEffect do

            setCloneSizeAndPosition(
                clone,
                hole
            )

            task.wait()
        end

        activeClones[v] = nil

        if clone and clone.Parent then
            clone:Destroy()
        end
    end)
end

local function clearAll()
    for _, connection in ipairs(connections) do
        if connection then
            connection:Disconnect()
        end
    end

    table.clear(connections)

    for _, clone in pairs(activeClones) do
        if clone then
            clone:Destroy()
        end
    end

    table.clear(activeClones)
end

local function startEffect(effectName)
    clearAll()

    activeEffect = effectName

    for _, obj in ipairs(Workspace:GetChildren()) do
        if obj.Name == "BlackHoleKick"
            or obj.Name == "BlackHoleDetected" then

            task.spawn(applyEffect, obj)
        end
    end

    table.insert(
        connections,
        Workspace.ChildAdded:Connect(function(obj)
            if obj.Name == "BlackHoleKick"
                or obj.Name == "BlackHoleDetected" then

                task.wait(0.1)

                if activeEffect then
                    applyEffect(obj)
                end
            end
        end)
    )
end

function setWater()
    startEffect("Water")
end

function setPurple()
    startEffect("Purple")
end

function setReal()
    startEffect("Real")
end

function clearBlackholes()
    activeEffect = nil
    clearAll()
end



