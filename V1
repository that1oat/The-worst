local BUTTON_WIDTH = 170
local BUTTON_HEIGHT = 50
local PADDING = 10
local RIGHT_MARGIN = 20
local TOP_MARGIN = 20

local function createButton(label, index)
    local btn = Instance.new("TextButton")

    btn.Size = UDim2.new(0, BUTTON_WIDTH, 0, BUTTON_HEIGHT)

    btn.Position = UDim2.new(
        1,
        -(BUTTON_WIDTH + RIGHT_MARGIN),
        0,
        TOP_MARGIN + (index - 1) * (BUTTON_HEIGHT + PADDING)
    )

    btn.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Text = label
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 16
    btn.Parent = gui

    btn.Active = true
    btn.Draggable = true

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 20)
    corner.Parent = btn

    btn.MouseEnter:Connect(function()
        TweenService:Create(
            btn,
            TweenInfo.new(0.2),
            {
                Size = UDim2.new(
                    0,
                    BUTTON_WIDTH + 10,
                    0,
                    BUTTON_HEIGHT + 5
                )
            }
        ):Play()
    end)

    btn.MouseLeave:Connect(function()
        TweenService:Create(
            btn,
            TweenInfo.new(0.2),
            {
                Size = UDim2.new(
                    0,
                    BUTTON_WIDTH,
                    0,
                    BUTTON_HEIGHT
                )
            }
        ):Play()
    end)

    return btn
end

local function clickEffect(btn)
    local shrink = TweenService:Create(
        btn,
        TweenInfo.new(0.08),
        {
            Size = UDim2.new(
                0,
                BUTTON_WIDTH - 10,
                0,
                BUTTON_HEIGHT - 5
            )
        }
    )

    local expand = TweenService:Create(
        btn,
        TweenInfo.new(0.08),
        {
            Size = UDim2.new(
                0,
                BUTTON_WIDTH,
                0,
                BUTTON_HEIGHT
            )
        }
    )

    shrink:Play()
    shrink.Completed:Wait()
    expand:Play()
end

--// Anti Grab
local antiGrabBtn = createButton("Anti Grab : Off", 1)

local function AntiGrabLoop()
    local st
    local model

    while ACGE do
        local spawnedFolder = workspace:FindFirstChild(
            player.Name .. "SpawnedInToys"
        )

        model = spawnedFolder
            and spawnedFolder:FindFirstChild("InstrumentWoodwindOcarina")

        if not model and plot then
            local plotItems = workspace:FindFirstChild("PlotItems")

            if plotItems then
                local plotFolder = plotItems:FindFirstChild(plot)

                if plotFolder then
                    model = plotFolder:FindFirstChild(
                        "InstrumentWoodwindOcarina"
                    )
                end
            end
        end

        if model then
            if player.Character then
                for _, prt in ipairs(player.Character:GetChildren()) do
                    local partOwner = prt:FindFirstChild("PartOwner")

                    if partOwner and partOwner.Value ~= "" then
                        local holdPart = model:FindFirstChild("HoldPart")

                        if holdPart then
                            local holdRemote =
                                holdPart:FindFirstChild(
                                    "HoldItemRemoteFunction"
                                )

                            if holdRemote then
                                task.spawn(function()
                                    pcall(function()
                                        holdRemote:InvokeServer(
                                            model,
                                            player.Character
                                        )
                                    end)
                                end)

                                local destroyToy =
                                    RS.MenuToys:FindFirstChild("DestroyToy")

                                if destroyToy then
                                    destroyToy:FireServer(model)
                                end

                                local humanoid =
                                    player.Character:FindFirstChildOfClass(
                                        "Humanoid"
                                    )

                                if humanoid then
                                    humanoid:SetStateEnabled(
                                        Enum.HumanoidStateType.Jumping,
                                        true
                                    )

                                    humanoid.AutoRotate = true

                                    if humanoid.Sit then
                                        humanoid.Sit = false
                                    end
                                end

                                CAS:UnbindAction("Escape")
                                CAS:UnbindAction("JumpRemover")

                                partOwner.Value = ""
                            end
                        end
                    end
                end
            end
        else
            local canSpawnToy = player:FindFirstChild("CanSpawnToy")

            if player.Character
                and canSpawnToy
                and canSpawnToy.Value
                and not st then

                st = tick()

                task.spawn(function()
                    pcall(function()
                        SpawnToyRF:InvokeServer(
                            "InstrumentWoodwindOcarina",
                            CFrame.new(1e5, 1e5, 1e5),
                            Vector3.zero
                        )
                    end)
                end)

            elseif st
                and tick() - st > 1
                and spawnedFolder
                and not spawnedFolder:FindFirstChild(
                    "InstrumentWoodwindOcarina"
                ) then

                st = nil
            end

            local grabbed = false

            if player.Character then
                for _, prt in ipairs(player.Character:GetChildren()) do
                    local partOwner = prt:FindFirstChild("PartOwner")

                    if partOwner and partOwner.Value ~= "" then
                        grabbed = true
                        break
                    end
                end
            end

            if grabbed then
                local struggle = RS.CharacterEvents:FindFirstChild(
                    "Struggle"
                )

                if struggle then
                    struggle:FireServer(player)
                end

                local char = player.Character

                if char then
                    local humanoid =
                        char:FindFirstChildOfClass("Humanoid")

                    local hrp =
                        char:FindFirstChild("HumanoidRootPart")

                    if humanoid and hrp then
                        local ragdoll =
                            RS.CharacterEvents:FindFirstChild(
                                "RagdollRemote"
                            )

                        if ragdoll then
                            ragdoll:FireServer(
                                hrp,
                                0.00000000001
                            )
                        end

                        for _, track in ipairs(
                            humanoid:GetPlayingAnimationTracks()
                        ) do
                            if track.Animation
                                and track.Animation.AnimationId
                                    == "rbxassetid://7047322890" then

                                track:Stop()
                            end
                        end
                    end
                end

                task.wait()
            end
        end

        local char = player.Character

        if char and (AGE or ACGE) then
            local humanoid =
                char:FindFirstChildOfClass("Humanoid")

            if humanoid then
                for _, track in ipairs(
                    humanoid:GetPlayingAnimationTracks()
                ) do
                    if track.Animation
                        and track.Animation.AnimationId
                            == "rbxassetid://7047322890" then

                        track:Stop()
                    end
                end
            end
        end

        task.wait()
    end
end

