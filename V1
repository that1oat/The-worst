local Players = game:GetService("Players")
local TextChatService = game:GetService("TextChatService")

local StickyToys = {
    NinjaShuriken = true,
    Shuriken = true,
}

local BrokenParts = {}

local PlotItems = workspace:WaitForChild("PlotItems")

local function announce(text)
    local channel = TextChatService:FindFirstChild("TextChannels")
        and TextChatService.TextChannels:FindFirstChild("RBXSystem")

    if channel then
        channel:DisplaySystemMessage(text)
    else
        warn(text)
    end
end

local function watchToy(toy, ownerName)
    if not toy:IsA("Model") then
        return
    end

    local StickyPart = toy:FindFirstChild("StickyPart")
    if not StickyPart then
        StickyPart = toy:WaitForChild("StickyPart", 5)
    end
    if not StickyPart then
        return
    end

    local StickyWeld = StickyPart:FindFirstChild("StickyWeld")
    if not StickyWeld then
        StickyWeld = StickyPart:WaitForChild("StickyWeld", 5)
    end
    if not StickyWeld then
        return
    end




    local function check()
        local part = StickyWeld.Part1
        if not part then
            return
        end


        if StickyPart.Position.Magnitude > 3000 then
            if not BrokenParts[part] then
                BrokenParts[part] = true

                announce(string.format(
                    "<font color='#ff00ea'>%s</font> offset <font color='#ffffff'>%s</font>",
                    ownerName or "Unknown",
                    part.Name
                ))
            end


            StickyWeld.Part1 = nil
            StickyPart.CFrame = part.CFrame
            StickyWeld.Part1 = part
        else
            BrokenParts[part] = nil
        end
    end

    StickyWeld:GetPropertyChangedSignal("Part1"):Connect(check)
    check()
end

local workspace = game:GetService("Workspace")

local function setupPlayer(player)
    local folderName = player.Name .. "SpawnedInToys"

    local folder = workspace:FindFirstChild(folderName)
    if not folder then
        folder = workspace:WaitForChild(folderName)
    end

    local function setupToy(toy)
        task.spawn(function()
            watchToy(toy, player.DisplayName)
        end)
    end

    folder.ChildAdded:Connect(setupToy)

    for _, toy in ipairs(folder:GetChildren()) do
        setupToy(toy)
    end
end

for _, player in ipairs(game:GetService("Players"):GetPlayers()) do
    task.spawn(setupPlayer, player)
end

game:GetService("Players").PlayerAdded:Connect(function(player)
    task.spawn(setupPlayer, player)
end)

