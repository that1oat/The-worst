--// PCLD Variables
getgenv().PCLD_TOGGLE = false
getgenv().PCLD_CONNECTION = nil
getgenv().PCLD_RESPAWN_CONNECTION = nil
getgenv().PCLD_SESSION = nil
getgenv().PCLD_ACTIVE_KILL = false

--// PCLD Functions
local function cleanupConnections()
    if getgenv().PCLD_CONNECTION then
        getgenv().PCLD_CONNECTION:Disconnect()
        getgenv().PCLD_CONNECTION = nil
    end

    if getgenv().PCLD_RESPAWN_CONNECTION then
        getgenv().PCLD_RESPAWN_CONNECTION:Disconnect()
        getgenv().PCLD_RESPAWN_CONNECTION = nil
    end
end

local function killPlayer()
    local char = player.Character
    if not char then
        return
    end

    local humanoid = char:FindFirstChildOfClass("Humanoid")

    if humanoid then
        humanoid.BreakJointsOnDeath = true
        humanoid.Health = 0
    end

    local hrp = char:FindFirstChild("HumanoidRootPart")

    if hrp then
        hrp:BreakJoints()
    end

    char:BreakJoints()
end

local function setupDeathListener()
    if not getgenv().PCLD_TOGGLE then
        return
    end

    local char = player.Character

    if not char then
        char = player.CharacterAdded:Wait()
    end

    local hum = char:WaitForChild("Humanoid")

    if getgenv().PCLD_CONNECTION then
        getgenv().PCLD_CONNECTION:Disconnect()
        getgenv().PCLD_CONNECTION = nil
    end

    print("PCLD: Setting up death listener on character")

    getgenv().PCLD_CONNECTION = hum.Died:Connect(function()
        if not getgenv().PCLD_TOGGLE then
            return
        end

        if getgenv().PCLD_ACTIVE_KILL then
            return
        end

        print("PCLD: Character died! Killing twice...")
        getgenv().PCLD_ACTIVE_KILL = true

        task.spawn(function()
            for i = 1, 2 do
                task.wait(0.15)

                killPlayer()

                if i < 2 then
                    player.CharacterAdded:Wait()
                end
            end

            getgenv().PCLD_ACTIVE_KILL = false

            task.wait(0.2)

            if getgenv().PCLD_TOGGLE then
                print("PCLD: Re-setting up death listener after respawn")
                setupDeathListener()
            end
        end)
    end)
end

local function setupRespawnMonitor()
    if getgenv().PCLD_RESPAWN_CONNECTION then
        getgenv().PCLD_RESPAWN_CONNECTION:Disconnect()
        getgenv().PCLD_RESPAWN_CONNECTION = nil
    end

    getgenv().PCLD_RESPAWN_CONNECTION = player.CharacterAdded:Connect(function()
        if not getgenv().PCLD_TOGGLE then
            return
        end

        if getgenv().PCLD_ACTIVE_KILL then
            return
        end

        task.wait(0.1)

        print("PCLD: Character respawned, setting up listener...")
        setupDeathListener()
    end)
end

