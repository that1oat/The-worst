    local text = message.Text:lower()

    -- match .plot1 to .plot5
    local plotNumber = text:match("^%.plot(%d)")
    plotNumber = tonumber(plotNumber)

    if plotNumber and plotNumber >= 1 and plotNumber <= 5 then
        local target = getPlotTarget(plotNumber)
        fireShurikensAt(target)
    end
end


